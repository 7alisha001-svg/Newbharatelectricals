    "canvas": "^3.2.3",
    "express": "^5.2.1",
    "image-size": "^2.0.2",
    "jimp": "^1.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.16.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
